# Claude API key. Set it in Vercel (Project → Settings → Environment Variables)
# for Preview and Production. Never commit a real key.
# Locally you can leave it unset and run `ant auth login` instead.
ANTHROPIC_API_KEY=

# Resend API key for front-desk handoff emails. Without it, handoffs are refused.
RESEND_API_KEY=
# Local only: 1 prints handoff emails to the terminal instead of sending them.
MAIL_LOG_ONLY=
# Optional. Sender on a domain verified in Resend; defaults to onboarding@resend.dev.
MAIL_FROM=
# Optional. Sends every handoff here instead of the client's frontDeskInbox.
HANDOFF_TO_OVERRIDE=
